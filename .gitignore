# Create .gitignore file
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Environment variables (CRITICAL - never commit these!)
.env
.env.local
.env.production
.env.*.local
.env.backup

# Logs
logs/
*.log

# Database
*.sqlite
*.db
*.db-journal

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# Build files
dist/
build/
*.min.js

# Temporary files
tmp/
temp/
*.tmp

# Backup files
*.bak
*.backup
EOF

# Add .gitignore to git
git add .gitignore
git commit -m "chore: add .gitignore to prevent committing sensitive files"
